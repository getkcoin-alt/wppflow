{
  "framework": "vite",
  "buildCommand": "npm run build",
  "ignoreCommand": "node scripts/release-check.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://srv1628639.hstgr.cloud/health"
    },
    {
      "source": "/api/:path*",
      "destination": "https://srv1628639.hstgr.cloud/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
